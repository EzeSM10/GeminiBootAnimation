#!/sbin/sh
# Magisk module installer entry point. KernelSU/APatch use customize.sh instead.
umask 022
ui_print() { echo "$1"; }
OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null
if [ ! -f /data/adb/magisk/util_functions.sh ]; then
    ui_print "Please install Magisk v20.4+ or install through KernelSU/APatch Manager."
    exit 1
fi
. /data/adb/magisk/util_functions.sh
if [ "$MAGISK_VER_CODE" -lt 20400 ]; then
    ui_print "Please install Magisk v20.4+."
    exit 1
fi
install_module
exit 0
